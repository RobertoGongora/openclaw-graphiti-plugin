{
  "name": "@robertogongora/graphiti",
  "version": "0.7.0-beta.5",
  "description": "Graphiti temporal knowledge graph plugin for OpenClaw",
  "type": "module",
  "main": "index.ts",
  "author": "Roberto Gongora",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RobertoGongora/openclaw-graphiti-plugin.git"
  },
  "keywords": [
    "openclaw",
    "plugin",
    "graphiti",
    "knowledge-graph",
    "memory",
    "neo4j",
    "temporal"
  ],
  "files": [
    "index.ts",
    "client.ts",
    "context-engine.ts",
    "shared.ts",
    "debug-log.ts",
    "memory-index.ts",
    "openclaw.plugin.json",
    "README.plugin.md",
    "skills"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "node -e \"const fs=require('fs');if(fs.existsSync('.README.repo.md')){console.error('prepack: .README.repo.md already exists; move it back to README.md first');process.exit(1)}fs.renameSync('README.md','.README.repo.md');fs.copyFileSync('README.plugin.md','README.md')\"",
    "postpack": "node -e \"const fs=require('fs');if(fs.existsSync('.README.repo.md'))fs.renameSync('.README.repo.md','README.md')\""
  },
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=20"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ]
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.48"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
