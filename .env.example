# Copy to .env (git-ignored). Both compose files read the same .env; variables
# prefixed TRANSCRIPT_ belong to compose.transcripts.yaml only.

# --- Shared -----------------------------------------------------------------
# Neo4j password for the `neo4j` user; the database and every client use it.
# Generate one with: openssl rand -hex 24
# The personal stack falls back to `graph-memory` when this is unset, and its
# services then stop with instructions until you change it. The transcripts stack
# has no default.
NEO4J_PASSWORD=change-me
# Accept the default password for a throwaway graph.
# MEMORY_ALLOW_DEFAULT_PASSWORD=1
# Image tag for the graph-memory services. Required by the transcripts stack;
# the personal stack falls back to `local`. `make image` tags the short commit.
GRAPH_MEMORY_TAG=local
# Recorded as the OCI revision label when compose builds the image.
GIT_SHA=unknown
# Neo4j server image (tag or digest).
NEO4J_IMAGE=neo4j:5.26-community
# OpenAI-compatible endpoint and key, used only when the provider is `compatible`.
MEMORY_LLM_URL=
MEMORY_LLM_API_KEY=
# Seconds allowed per model call.
MEMORY_LLM_TIMEOUT=420
# Episodes due for extraction before intake pauses reading new sources.
MEMORY_INTAKE_QUEUE=32
# Transcript files with work left that one scan may open.
MEMORY_INTAKE_FILES=4
# Feed transcripts even though older feeds cannot be named under the current roots.
# Dangerous: with wrong roots every known session is ingested again. Prefer
# `graph-memory feeds stamp`.
# MEMORY_FEED_ACCEPT_UNMATCHED=1

# --- Personal graph (compose.yaml) -------------------------------------------
# Host directory of markdown memory files, mounted read-only at /bank.
MEMORY_BANK_PATH=./memory-bank
# Graph partition every read and write is scoped to.
MEMORY_NAMESPACE=personal
# Bearer token required by the HTTP MCP endpoint. openssl rand -hex 32
MEMORY_HTTP_TOKEN=change-me
# Extra Host header names accepted besides loopback (comma list), e.g. a tailnet name.
MEMORY_HTTP_HOSTS=
# Extra browser Origins accepted besides loopback (comma list).
MEMORY_HTTP_ORIGINS=
# Host port of the MCP endpoint (bound to 127.0.0.1).
MEMORY_MCP_PORT=8765
# Extraction provider: codex (CLI login), compatible (MEMORY_LLM_URL), or caller (none).
MEMORY_LLM=codex
MEMORY_MODEL=gpt-5.6-terra
MEMORY_REASONING_EFFORT=low
# Concurrent extraction workers.
MEMORY_WORKERS=4
# Container memory ceilings.
MEMORY_WORKER_MEM_LIMIT=6g
MEMORY_NEO4J_MEM_LIMIT=1536m
# Docker volume holding the personal database.
MEMORY_VOLUME=graph-memory_graph_memory
# Only Origin allowed to call the Neo4j HTTP API cross-site (`browser` profile).
MEMORY_NEO4J_BROWSER_ORIGIN=http://127.0.0.1:17474

# --- Transcripts graph (compose.transcripts.yaml) ----------------------------
# Session directories, mounted read-only.
CLAUDE_SESSIONS_PATH=/Users/you/.claude/projects
CODEX_SESSIONS_PATH=/Users/you/.codex/sessions
# Host directory holding the codex login (auth.json); the worker writes to it.
TRANSCRIPT_AUTH_PATH=/Users/you/.local/share/graph-memory/docker-auth
# Owner of TRANSCRIPT_AUTH_PATH on the host (`id -u`, `id -g`); the worker runs as it.
HOST_UID=501
HOST_GID=20
# Bearer token required by the transcripts MCP endpoint. openssl rand -hex 32
TRANSCRIPT_MCP_TOKEN=change-me
TRANSCRIPT_MCP_HOSTS=
TRANSCRIPT_MCP_ORIGINS=
TRANSCRIPT_MCP_PORT=8766
TRANSCRIPT_LLM=codex
TRANSCRIPT_MODEL=gpt-5.6-terra
TRANSCRIPT_REASONING_EFFORT=low
TRANSCRIPT_WORKERS=8
# Audit every Nth journal write against the whole graph (1 = every write, 0 = off).
MEMORY_JOURNAL_AUDIT=503
TRANSCRIPT_WORKER_MEM_LIMIT=6g
# Neo4j sizing. Keep the limit at heap max + pagecache + ~2g.
TRANSCRIPT_NEO4J_HEAP_INITIAL=1g
TRANSCRIPT_NEO4J_HEAP_MAX=4g
TRANSCRIPT_NEO4J_PAGECACHE=2g
TRANSCRIPT_NEO4J_TX_MEMORY_MAX=1g
TRANSCRIPT_NEO4J_MEM_LIMIT=8g
# Docker volume holding the transcripts database.
TRANSCRIPT_VOLUME=graph-memory-transcripts_source-v1
TRANSCRIPT_NEO4J_BROWSER_ORIGIN=http://127.0.0.1:27474

# --- Read by the CLI outside compose ----------------------------------------
# NEO4J_URI=bolt://127.0.0.1:17687
# NEO4J_USER=neo4j
# NEO4J_DATABASE=neo4j
# Integration tests and evals run only when this points at a disposable database
# (`make test-db-up`); they wipe what they touch.
# MEMORY_TEST_NEO4J_URI=bolt://127.0.0.1:37687
# MEMORY_TEST_NEO4J_PASSWORD=
